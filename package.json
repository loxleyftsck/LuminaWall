{
  "name": "luminawall",
  "version": "0.2.0",
  "private": true,
  "author": "Herald Ginting",
  "scripts": {
    "dev": "node -r ./windows-readlink-patch.js node_modules/next/dist/bin/next dev --turbopack",
    "build": "node -r ./windows-readlink-patch.js node_modules/next/dist/bin/next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "assets": "node scripts/generate-assets.cjs",
    "check:production-config": "node scripts/check-production-config.cjs",
    "build:production": "node scripts/production-build.cjs",
    "smoke:metadata": "node scripts/check-metadata.cjs"
  },
  "dependencies": {
    "lucide-react": "^0.525.0",
    "next": "15.5.27",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "postcss": "8.5.29",
    "nanoid": "3.3.20",
    "source-map-js": "1.2.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@napi-rs/canvas": "1.0.10",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3"
  }
}

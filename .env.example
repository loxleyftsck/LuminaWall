# Set the actual public HTTPS origin before deploying (no path/query/fragment).
NEXT_PUBLIC_SITE_URL=https://your-domain.example
# Use true in production hosting environments. Local development may leave it false.
REQUIRE_PRODUCTION_URL=false
# Optional: enable only when public/wasm/attractor.wasm has been built.
NEXT_PUBLIC_ENABLE_WASM=false
